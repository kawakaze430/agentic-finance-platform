# Copy to .env for the PostgreSQL Compose profile. Replace every password.
DATABASE_PASSWORD=replace-with-a-long-unique-database-password
FINANCE_ANALYST_PASSWORD=replace-with-a-long-unique-analyst-password
FINANCE_APPROVER_PASSWORD=replace-with-a-long-unique-approver-password
FINANCE_ADMIN_PASSWORD=replace-with-a-long-unique-admin-password
AGENT_MODE=demo
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b
